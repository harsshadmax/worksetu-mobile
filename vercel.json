{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://worksetu-api.onrender.com/api/:path*"
    },
    {
      "source": "/socket.io",
      "destination": "https://worksetu-api.onrender.com/socket.io/"
    },
    {
      "source": "/socket.io/",
      "destination": "https://worksetu-api.onrender.com/socket.io/"
    },
    {
      "source": "/socket.io/:path+",
      "destination": "https://worksetu-api.onrender.com/socket.io/:path+"
    }
  ]
}
